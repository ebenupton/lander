# b32/tools/b2probe.patch: b2's headless probe (github.com/tom-seddon/b2, e1c9b84), a
# test in its test_beeb: env B2PROBE_DISC (an .ssd: *RUN LANDER), B2PROBE_FIELDS,
# B2PROBE_KEYS (S shift, Z), B2PROBE_PNG (b2's TV picture), B2PROBE_LOGW (CRTC, ULA,
# timer writes and reads by time from the vsync).  Prints each field's length and the
# lines whose hsync-to-hsync interval is not 64us.  To build:
#   git clone --recursive https://github.com/tom-seddon/b2 && cd b2 && git apply
#   .../b2probe.patch && mkdir -p build/r && cd build/r && cmake -G Ninja
#   -DCMAKE_BUILD_TYPE=RelWithDebInfo ../.. && ninja test_beeb
#   B2PROBE_DISC=$PWD/build32/lander32.ssd .../test_beeb -t b2probe
diff --git a/src/beeb/tests/test_beeb.cpp b/src/beeb/tests/test_beeb.cpp
index 68f8624..c098b4f 100644
--- a/src/beeb/tests/test_beeb.cpp
+++ b/src/beeb/tests/test_beeb.cpp
@@ -2773,10 +2773,142 @@ static Options GetOptions(int argc, char *argv[]) {
 //////////////////////////////////////////////////////////////////////////
 //////////////////////////////////////////////////////////////////////////
 
+
+//////////////////////////////////////////////////////////////////////////
+// b2probe (bandfill b32): env B2PROBE_DISC (an .ssd, *RUN LANDER), B2PROBE_FIELDS,
+// B2PROBE_KEYS ("S" shift, "Z" z held), B2PROBE_PNG (the TV picture after the run).
+// Prints, per line from the vsync, the hsync-to-hsync intervals (us) seen when
+// not all 64.
+class B2ProbeTest : public Test {
+  public:
+    std::string GetFullName() const override { return "b2probe"; }
+    void Run() override {
+        const char *disc = getenv("B2PROBE_DISC");
+        if (!disc) return;
+        int fields = getenv("B2PROBE_FIELDS") ? atoi(getenv("B2PROBE_FIELDS")) : 50;
+        const char *keys = getenv("B2PROBE_KEYS") ? getenv("B2PROBE_KEYS") : "";
+        TestBBCMicro bbc(GetBBCBDiskType(&DISC_INTERFACE_ACORN_1770));
+        bbc.StartCaptureOSWRCH();
+        bbc.LoadDiskImage(0, disc);
+        bbc.RunUntilOSWORD0(10.0);
+        bbc.Paste(getenv("B2PROBE_CMD") ? std::string(getenv("B2PROBE_CMD")) + "\r" : std::string("*RUN LANDER\r"));
+        TVOutput tv;
+        SoundDataUnit snd;
+        VideoDataUnit vu;
+        // settle: 3 seconds
+        uint64_t t = 0;
+        std::vector<VideoDataUnit> buf;
+        std::vector<std::pair<uint64_t, std::string>> evs;
+        bool logw = getenv("B2PROBE_LOGW") != nullptr;
+        uint16_t last_w_addr = 0; uint64_t last_w_t = ~0ull;
+        auto step = [&](bool record, std::vector<uint64_t> *hs, std::vector<uint64_t> *vs, bool &lh, bool &lv) {
+            uint32_t r = bbc.Update(&vu, &snd);
+            if (logw && record && (r & BBCMicroUpdateResultFlag_Host)) {
+                const M6502 *cpu = bbc.GetM6502();
+                uint16_t a = cpu->abus.w;
+                static uint16_t pa = 0; static uint8_t pd = 0; static bool pr = false;
+                if (pr && (pa == 0xfe64 || pa == 0xfe66) && a != pa) {
+                    char tmp[32];
+                    snprintf(tmp, sizeof tmp, "%s%02x", pa == 0xfe64 ? "rC" : "rL", pd);
+                    evs.push_back({t, tmp});
+                }
+                pa = a; pd = cpu->dbus; pr = cpu->read != 0;
+                if (!cpu->read && (a == 0xfe00 || a == 0xfe01 || a == 0xfe20 || a == 0xfe65 || a == 0xfe66 || a == 0xfe67) && !(a == last_w_addr && t == last_w_t)) {
+                    char tmp[32];
+                    snprintf(tmp, sizeof tmp, "%s%02x", a == 0xfe00 ? "I" : a == 0xfe01 ? "D" : a == 0xfe20 ? "U" : a == 0xfe65 ? "T1H" : "L", cpu->dbus);
+                    evs.push_back({t, tmp});
+                    last_w_addr = a; last_w_t = t;
+                }
+            }
+            if (r & BBCMicroUpdateResultFlag_VideoUnit) {
+                ++t;
+                bool h = (vu.pixels.pixels[1].bits.x & VideoDataUnitFlag_HSync) != 0;
+                bool v = (vu.pixels.pixels[1].bits.x & VideoDataUnitFlag_VSync) != 0;
+                if (record) {
+                    if (h && !lh) hs->push_back(t);
+                    if (v && !lv) vs->push_back(t);
+                }
+                lh = h; lv = v;
+                buf.push_back(vu);
+                if (buf.size() >= 1000) { tv.Update(buf.data(), buf.size()); buf.clear(); }
+            }
+        };
+        bool lh = false, lv = false;
+        std::vector<uint64_t> hs, vs;
+        for (uint64_t i = 0; i < 4000000ull * (getenv("B2PROBE_SETTLE") ? atoi(getenv("B2PROBE_SETTLE")) : 12); ++i) step(false, &hs, &vs, lh, lv);
+        for (const char *k = keys; *k; ++k) {
+            if (*k == 'S') bbc.SetKeyState(BeebKey_Shift, true);
+            if (*k == 'Z') bbc.SetKeyState(BeebKey_Z, true);
+        }
+        uint64_t n = (uint64_t)(fields + 2) * 80000ull;
+        for (uint64_t i = 0; i < n; ++i) step(true, &hs, &vs, lh, lv);
+        tv.Update(buf.data(), buf.size()); buf.clear();
+        // per line after each vsync: intervals
+        std::map<int, std::map<double, int>> by_line;
+        size_t hi = 0;
+        for (size_t f = 1; f + 1 < vs.size(); ++f) {
+            while (hi < hs.size() && hs[hi] < vs[f]) ++hi;
+            int line = 0;
+            for (size_t j = hi; j + 1 < hs.size() && hs[j + 1] < vs[f + 1]; ++j, ++line) {
+                by_line[line][(hs[j + 1] - hs[j]) / 2.0]++;
+            }
+        }
+        if (logw) {
+            size_t ei = 0;
+            for (size_t f = 1; f + 1 < vs.size() && f < 5; ++f) {
+                printf("field at %llu:", (unsigned long long)vs[f]);
+                while (ei < evs.size() && evs[ei].first < vs[f]) ++ei;
+                std::string idx;
+                for (; ei < evs.size() && evs[ei].first < vs[f + 1]; ++ei) {
+                    printf(" %s@%.1f", evs[ei].second.c_str(), (evs[ei].first - vs[f]) / 2.0);
+                }
+                printf("\n");
+            }
+        }
+        if (logw) {
+            size_t hj = 0;
+            for (size_t f = 1; f + 1 < vs.size() && f < 6; ++f) {
+                while (hj < hs.size() && hs[hj] < vs[f]) ++hj;
+                printf("field %zu hsyncs:", f);
+                for (size_t k = hj; k < hs.size() && hs[k] < vs[f + 1] && k < hj + 10; ++k) printf(" %.1f", (hs[k] - vs[f]) / 2.0);
+                printf(" ... n=");
+                size_t n = 0; for (size_t k = hj; k < hs.size() && hs[k] < vs[f + 1]; ++k) ++n;
+                printf("%zu\n", n);
+            }
+        }
+        printf("fields %zu, field lengths(us):", vs.size() ? vs.size() - 1 : 0);
+        std::map<double, int> fl;
+        for (size_t f = 1; f + 1 < vs.size(); ++f) fl[(vs[f + 1] - vs[f]) / 2.0]++;
+        for (auto &e : fl) printf(" %.1f x%d", e.first, e.second);
+        printf("\n");
+        for (auto &l : by_line) {
+            bool odd = false;
+            for (auto &e : l.second) if (e.first != 64.0) odd = true;
+            if (!odd) continue;
+            printf("line %d:", l.first);
+            for (auto &e : l.second) printf(" %.1f x%d", e.first, e.second);
+            printf("\n");
+        }
+        if (const char *png = getenv("B2PROBE_PNG")) {
+            const uint32_t *px = tv.GetTexturePixels(nullptr);
+            std::vector<uint8_t> rgb(TV_TEXTURE_WIDTH * TV_TEXTURE_HEIGHT * 3);
+            for (size_t i = 0; i < (size_t)TV_TEXTURE_WIDTH * TV_TEXTURE_HEIGHT; ++i) {
+                uint32_t p = px[i];
+                rgb[i * 3 + 0] = (p >> 16) & 255;
+                rgb[i * 3 + 1] = (p >> 8) & 255;
+                rgb[i * 3 + 2] = p & 255;
+            }
+            stbi_write_png(png, TV_TEXTURE_WIDTH, TV_TEXTURE_HEIGHT, 3, rgb.data(), TV_TEXTURE_WIDTH * 3);
+            printf("pc %04x, oswrch: %s\n", (unsigned)bbc.GetM6502()->pc.w, GetPrintable(bbc.oswrch_output).c_str());
+        }
+    }
+};
+
 int main(int argc, char *argv[]) {
     Options options = GetOptions(argc, argv);
 
     std::vector<std::unique_ptr<Test>> all_tests;
+    all_tests.push_back(std::make_unique<B2ProbeTest>());
     all_tests.push_back(std::make_unique<StandardTest>("VTIMERS", GetBTapeType()));
     all_tests.push_back(std::make_unique<StandardTest>("VIA.AC1", GetBTapeType()));
     all_tests.push_back(std::make_unique<StandardTest>("VIA.AC2", GetBTapeType()));
